{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AdventureMod: Build (Debug|Win32)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.bat",
            "args": ["Debug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Baut AdventureMod.vcxproj (Debug|Win32) via MSBuild. Findet MSBuild automatisch ueber vswhere.exe (siehe scripts/build.bat) -- keine 'Developer Command Prompt' noetig."
        },
        {
            "label": "AdventureMod: Build (Release|Win32)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.bat",
            "args": ["Release"],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Baut AdventureMod.vcxproj (Release|Win32) via MSBuild."
        },
        {
            "label": "AdventureMod: Clean (Debug|Win32)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/clean.bat",
            "args": ["Debug"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Raeumt Debug|Win32-Build-Ausgaben von AdventureMod.vcxproj auf."
        },
        {
            "label": "AdventureMod: Clean (Release|Win32)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/clean.bat",
            "args": ["Release"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Raeumt Release|Win32-Build-Ausgaben von AdventureMod.vcxproj auf."
        }
    ]
