grundhoehe=8.0
wellen=3.0
wellen_groesse=30.0
huegel_anteil=0.15
huegel_hoehe=18.0
huegel_groesse=90.0
glaetten=0.90
berge=0.20
native_baeume=100

# Fluesse und Seen (Wasser auf Gelaendehoehe)
