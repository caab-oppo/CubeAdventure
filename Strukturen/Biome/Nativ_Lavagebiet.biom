minen_licht=255,214,120
minen_schiene=95,95,105

# Kreaturen: native Rassen-IDs (Mob-Labor), Anteil der ersetzten Landspawns
rassen=
rassen_anteil=0.70
mobs=
mobs_max=6
mobs_level=-1
# Schwierigkeit: modus 0 = Spielerlevel +- abweichung, 1 = feste Spanne min..max
mobs_level_modus=0
mobs_level_min=1
mobs_level_max=10
mobs_level_abweichung=0
spawner_rassen=0

# Biome II: Spawnregeln am nativen Spawn. spawn=was;wo;gewicht;level_min;level_max;verhalten
#  was: Zahl = native Rasse, sonst eigener Mob (Pfad unter Strukturen\Mobs ohne .mob)
#  wo: leer = ueberall, land, wasser, wald, wiese, savanne, wueste, dschungel, schnee, gebirge, sumpf, kueste
#  level 0 = nativ; verhalten 0 Standard, 1 friedlich, 2 feindlich
spawn_anteil=70
# Ueberschreibungen: tierwelt_anteil -1 = allgemein; tier_verhalten 0 nativ, 1 alle friedlich, 2 alle feindlich;
# tier_level_modus 0 nativ, 1 feste Spanne, 2 nativ + versatz
tierwelt_anteil=-1
tier_verhalten=0
tier_level_modus=0
tier_level_min=1
tier_level_max=10
tier_level_versatz=0

# Pflanzen (Versuche je Zone, Arten mit Gewicht)
pflanzen_dichte=0
pflanzen_arten=Baum:0,Busch:0,Pilz:0,Kristall:0,Kaktus:0,Halme:0
