bergzug_breite=250
bergzug_abstand=1400
bergzug_zacken=0.50
schneegrenze=0

# Freie Ebene in der Mitte jeder Biomzelle (Radius, Uebergang, Hoehe in Bloecken)
ebene_an=0
ebene_radius=1200
ebene_rand=250
ebene_hoehe=20
# Stadt auf der Ebene: 0 keine, 1 Elfenstadt, 2 Zwergenstadt, 3 zufaellig je Zelle; Radius 0 = ganze Ebene
stadt=0
stadt_radius=0
# Tierviertel der Stadt: Rassen-IDs in den Gehegen (leer = Schwein 33, Schaf 34, Kuh 100, Huhn 56)
stadt_tiere=

# Sternmassiv (Hochebene = Ebene oben; Bergring, sternfoermige Grate und Taeler mit Fluss und See)
stern_an=0
stern_arme=8
