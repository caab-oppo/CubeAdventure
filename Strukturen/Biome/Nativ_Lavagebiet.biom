# Eigenes Biom fuer den AdventureMod (Biom-Werkstatt im LAB). Anleitung: BIOM_ANLEITUNG.md
name=Nativ Lavagebiet
aktiv=1

# NATIVES Biom: gilt fuer alle Klimazellen der Klasse 'Lavagebiet' (ohne eigenes Biom).
# Auswahl/Klima unten werden dafuer nicht benutzt. Vorgaben aendern nichts -- nur Eingestelltes wirkt.
nativ=6

# Auswahl: Anteil in % der passenden Landzellen; klima 0 alle,1 gemaessigt,2 heiss,3 kalt,4 feucht,5 trocken
anteil=100
klima=0
klima_setzen=0
temperatur=0.50
feuchte=0.50

# Boden (bodentyp 0 = nativ, 4 Gras, 9 Sand, 10 Schnee, 12 Lava-Boden)
boden=70,140,60
boden2=50,110,45
bodentyp=0
staerke=0.00
fels=110,105,100
fels_an=0

# Gelaende (Bloecke; Meeresspiegel 0 -- unter Hoehe 1 entsteht Wasser)
