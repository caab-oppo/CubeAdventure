# Zonen-Modell fuer den AdventureMod (LAB -> Zonen-Modelle). Wird mit der Zone erzeugt wie die nativen Baeume.
# Schimmerpilz (2026-10-19): Zutat zum Verbessern der Lampe an der Werkbank (Rezepte Lampe_*.rez).
name=Schimmerpilz
aktiv=0
art=sammelbar
# Sammelbar: eigener Gegenstand (Typ 0x0B, Unterart gegenstand_id -- nicht aendern, sonst passen gesammelte Exemplare nicht mehr)
gegenstand_name=Schimmerpilz
gegenstand_id=0x34
modell=09_Leuchtpilz.cub
# gebiet: ueberall | vanilla | biom:<datei.biom>;  boden: 0 alle, 4 Gras, 9 Sand, 10 Schnee, 12 Lava-Boden
gebiet=ueberall
boden=4
# dichte: Baum/Blume = Versuche je Zone, Dungeon = % Chance je Zone
dichte=3
hang_min=0.00
hang_max=0.80
abstand=8
hoehe_min=-1000
hoehe_max=1000
# klein_faktor (nur Blume): 0 = als Bloecke setzen, sonst Modell x Faktor wie die nativen Pflanzen (Schilf 0.09)
klein_faktor=0.050
wind=0
z_versatz=0
drehen=1
unebenheit=0
fundament=0
